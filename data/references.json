    "item": {
      "description": "Geometry Dash Item ID",
      "allocatable": true
    },
    "control": {
      "description": "Geometry Dash Control ID",
      "allocatable": true
    },
    "color": {
      "description": "Geometry Dash Color Channel ID",
      "allocatable": false,
      "notes": "Built-in/special color channels make generic next-free allocation unsafe until their rules are modeled."
    },
    "block": {
      "description": "Geometry Dash Collision Block ID",
      "allocatable": false,
      "notes": "Semantic support is available; automatic allocation is intentionally deferred."
    },
    "force": {
      "description": "Geometry Dash Force ID",
      "allocatable": false,
      "notes": "Assigned to force blocks; blocks sharing a nonzero ID do not stack."
    },
    "song_channel": {
      "description": "Geometry Dash Song Channel ID",
      "allocatable": false,
      "notes": "Used by Song/Edit Song triggers."
    },
    "trigger_channel": {
      "description": "Geometry Dash Trigger Channel",
      "allocatable": false,
      "notes": "Limits which triggers are active."
    },
    "material": {
      "description": "Geometry Dash Material ID",
      "allocatable": false,
      "notes": "Assigned to objects and matched by material-sensitive events."
    },
    "gradient": {
      "description": "Geometry Dash Gradient ID",
      "allocatable": false,
      "notes": "Identifies a Gradient trigger; documented maximum 999."
    },
    "area_effect": {
      "description": "Geometry Dash Area Effect ID",
      "allocatable": false,
      "notes": "Area-effect namespace; intentionally distinct from Enter Effect IDs."
    },
    "enter_effect": {
      "description": "Geometry Dash Enter Effect ID",
      "allocatable": false,
      "notes": "Enter-effect namespace; intentionally distinct from Area Effect IDs."
    },
    "enter_channel": {
      "description": "Geometry Dash Enter Channel ID",
      "allocatable": false,
      "notes": "Objects belong to Enter Channels; Enter effects target channels."
    },
    "sfx_group": {
      "description": "Geometry Dash SFX Group ID",
      "allocatable": false,
      "notes": "Groups SFX instances for Edit SFX targeting."
    },
    "sfx_unique": {
      "description": "Geometry Dash SFX Unique ID",
      "allocatable": false,
      "notes": "Unique within an SFX Group, not globally scoped."
    }
  },
