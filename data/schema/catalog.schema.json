{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "object_files"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "object_files": {
      "type": "array",
      "items": {"type": "string", "pattern": "^objects/.+\\.json$"},
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
